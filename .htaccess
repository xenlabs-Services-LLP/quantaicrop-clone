# =====================================================================
# QuantAI Corp — root .htaccess (Apache / XAMPP)
# =====================================================================

DirectoryIndex index.php

# ---- Clean URLs: hide .php everywhere -----------------------------
# /about serves about.php, /admin/contacts serves admin/contacts.php,
# /blog/{slug} serves blog-post.php?slug={slug} — no .php ever shown.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1a) Old-style blog-post.php?slug=X links -> /blog/X (preserves the slug
  #     instead of losing it in the generic .php-stripping redirect below).
  RewriteCond %{THE_REQUEST} \s/+blog-post\.php\?slug=([a-z0-9-]+)\s [NC]
  RewriteRule ^ /blog/%1? [R=301,L]

  # 1b) Any other URL that still ends in .php gets permanently redirected
  #     to the clean, extensionless version (single canonical URL for SEO).
  RewriteCond %{THE_REQUEST} \s/+(.+)\.php[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,NE]

  # 2) Pretty blog post URLs: /blog/some-article-slug -> blog-post.php
  RewriteRule ^blog/([a-z0-9-]+)/?$ blog-post.php?slug=$1 [L,QSA]

  # 3) Generic fallback: /anything -> anything.php, if that file exists
  #    and the request isn't already a real file or directory (assets,
  #    /admin/, /uploads/, etc. are left completely alone).
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.php -f
  RewriteRule ^(.*?)/?$ $1.php [L]
</IfModule>

# ---- Security headers -------------------------------------------------
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # Content-Security-Policy is emitted per-request from PHP (see
  # includes/functions.php -> send_security_headers()) so it can include a
  # fresh nonce for the JSON-LD structured-data script on every page. Do
  # not also set it here — two CSP headers are enforced as an
  # intersection and would break the nonce'd script.
  # Uncomment once served over HTTPS in production:
  # Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains"
</IfModule>

# ---- Hide server signature / directory listings ------------------------
Options -Indexes
ServerSignature Off

# ---- Block access to sensitive file types anywhere in the site --------
<FilesMatch "\.(sql|md|log|env|ini|bak|sh)$">
  Require all denied
</FilesMatch>

# ---- Gzip compression ---------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# ---- Browser caching ------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
</IfModule>

# Note: PHP execution is disabled specifically inside /uploads/resumes/
# via its own .htaccess — see that directory for the resume-upload
# hardening rules. Do not disable PHP site-wide here.
